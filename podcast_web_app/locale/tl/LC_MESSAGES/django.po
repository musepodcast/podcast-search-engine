msgstr ""
"Ikaw ay may karapatan upang ma-access, i-correct, o humingi ng pagtanggal ng"
" iyong personal na data sa anumang oras. Upang gamitin ang mga karapatan na "
"ito o kung mayroon kang mga katanungan tungkol sa Privacy Policy na ito, "
"makipag-ugnay sa amin sa:"

#: .\podcasts\templates\podcasts\signup.html:225
#: .\podcasts\templates\socialaccount\signup.html:126
msgid "Changes to This Privacy Notice"
msgstr "Pagbabago sa Pakikinig sa Privacy"

#: .\podcasts\templates\podcasts\signup.html:226
#: .\podcasts\templates\socialaccount\signup.html:127

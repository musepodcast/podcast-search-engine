#: .\podcasts\templates\registration\login_2fa.html:7
msgid "Enter OTP Token"
msgstr "Nhập mã thông báo OTP"

#: .\podcasts\templates\registration\login_2fa.html:11
msgid "Submit"
msgstr "Đưa ra"

#: .\podcasts\templates\registration\password_change_done.html:7
msgid "Password Changed"
msgstr "Chữ mật khẩu thay đổi"

#: .\podcasts\templates\registration\password_change_done.html:8
msgid "Your password has been successfully changed."
msgstr "Mật khẩu của bạn đã được thay đổi thành công."

#: .\podcasts\templates\registration\password_change_done.html:9
msgid "Return to Profile"
msgstr "Trở lại Profile"

#: .\podcasts\templates\registration\password_change_form.html:31
msgid "Current Password"
msgstr "Mật khẩu hiện tại"

#: .\podcasts\templates\registration\password_change_form.html:46
msgid "New Password"
msgstr "Mật khẩu mới"

#: .\podcasts\templates\registration\password_change_form.html:64
msgid "Confirm New Password"
msgstr "Xác nhận mật khẩu mới"

#: .\podcasts\templates\registration\password_reset_complete.html:7
msgid "Password Reset Complete"
msgstr "Đặt lại mật khẩu hoàn chỉnh"

#: .\podcasts\templates\registration\password_reset_complete.html:9
msgid ""
"Your password has been successfully reset. You can now log in with your new "
"password."
msgstr ""
"Mật khẩu của bạn đã được thiết lập lại thành công. Bây giờ bạn có thể đăng "
"nhập với mật khẩu mới của mình."

#: .\podcasts\templates\registration\password_reset_confirm.html:7
msgid "Reset Your Password"
msgstr "Đặt lại mật khẩu của bạn"

#: .\podcasts\templates\registration\password_reset_confirm.html:11
#: .\podcasts\templates\registration\password_reset_form.html:7
#: .\podcasts\templates\security\locked_out.html:32
msgid "Reset Password"
msgstr "Reset Password"

#: .\podcasts\templates\registration\password_reset_done.html:7
msgid "Password Reset Email Sent"
msgstr "Password Reset Email được gửi"

#: .\podcasts\templates\registration\password_reset_done.html:9
msgid ""
"We've emailed you instructions for resetting your password. Please check "
"your inbox (and spam folder) for the reset link."
msgstr ""
"Chúng tôi đã gửi cho bạn các hướng dẫn để thiết lập lại mật khẩu của bạn. "
"Xin vui lòng kiểm tra hộp thư đến của bạn (và thư mục spam) cho liên kết "
"thiết lập lại."

#: .\podcasts\templates\registration\password_reset_form.html:8
msgid ""
"Enter your email address and we'll send you a link to reset your password."
msgstr ""
"Nhập địa chỉ email của bạn và chúng tôi sẽ gửi cho bạn một liên kết để đặt "
"lại mật khẩu của bạn."

#: .\podcasts\templates\registration\password_reset_form.html:12
msgid "Send Reset Link"
msgstr "Gửi Reset Link"

#: .\podcasts\templates\security\locked_out.html:9
msgid "Account Locked"
msgstr "Tài khoản bị khóa"

#: .\podcasts\templates\security\locked_out.html:11
msgid ""
"For your security, we’ve temporarily locked your account after multiple "
"failed login attempts."
msgstr ""
"Vì sự an toàn của bạn, chúng tôi đã tạm thời khóa tài khoản của bạn sau "
"nhiều nỗ lực đăng nhập thất bại."

#: .\podcasts\templates\security\locked_out.html:17
msgid "Please wait and try again."
msgstr "Vui lòng chờ và thử lại."

#: .\podcasts\templates\security\locked_out.html:19
msgid "Time until unlock:"
msgstr "Thời gian cho đến khi mở khóa:"

#: .\podcasts\templates\security\locked_out.html:25
msgid "Unlocks at"
msgstr "Tháo khóa tại"

#: .\podcasts\templates\security\locked_out.html:37
#, python-format
msgid "If you think this was a mistake, contact support at %(email)s."
msgstr ""
"Nếu bạn nghĩ đây là một sai lầm, hãy liên hệ với hỗ trợ tại %(email)s."

#: .\podcasts\templates\socialaccount\cancelled.html:7
#: .\podcasts\templates\socialaccount\error.html:7
msgid "Login Cancelled"
msgstr "Login bị hủy"

#: .\podcasts\templates\socialaccount\cancelled.html:9
#: .\podcasts\templates\socialaccount\error.html:9
msgid "You decided not to sign in with that external account."
msgstr "Anh quyết định không đăng nhập với tài khoản bên ngoài đó."

#: .\podcasts\templates\socialaccount\signup.html:7
msgid "Finish signing up"
msgstr "Kết thúc đăng ký"

#: .\podcasts\templates\socialaccount\signup.html:61
msgid "Muse Podcast, LLC’s Privacy Notice"
msgstr "Thông báo về quyền riêng tư của Muse Podcast, LLC"

#: .\podcasts\templates\socialaccount\signup.html:67
msgid "Complete Signup"
msgstr "Đăng ký đầy đủ"


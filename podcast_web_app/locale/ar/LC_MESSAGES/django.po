msgid ""
"Your support ticket was unsuccessful, file size is too large, needs to be ≤ "
"2 MB."
msgstr ""
"تذكرة الدعم الخاصة بك لم تنجح، حجم الملف كبير جدا، يجب أن يكون ≤ 2 MB."

#: .\podcasts\templates\podcasts\support_ticket.html:161
msgid ""
"Your support ticket was unsuccessful, file type incorrect, only "
"(JPG/PNG/GIF) are accepted."
msgstr ""
"تذكرة الدعم الخاصة بك لم تنجح، نوع الملف غير صحيح، فقط (JPG/PNG/GIF) يتم "
"قبولها."

#: .\podcasts\templates\podcasts\support_ticket.html:163
msgid ""
"Your support ticket was unsuccessful, file type incorrect (only JPG/PNG/GIF)"
" and file size is too large (≤ 2 MB)."
msgstr ""
"كانت تذكرة الدعم الخاصة بك غير ناجحة، ونوع الملف غير صحيح (JPG/PNG/GIF فقط) "
"وحجم الملف كبير جدا (≤ 2 MB)."

#: .\podcasts\templates\podcasts\support_ticket.html:166
#, python-format
msgid ""
"You’ve reached your limit of %(limit)s open tickets "
"(%(open_count)s/%(limit)s). Please wait for one to complete or cancel before"
" opening a new one."
msgstr ""
"لقد وصلت إلى حد التذاكر المفتوحة %(limit)s (%(open_count)s/%(limit)s). يرجى "
"الانتظار حتى يتم إكمال واحدة أو إلغاءها قبل فتح واحدة جديدة."

